<?xml version='1.0' encoding='utf-8'?>
<robot name="am1_step_cad">
  <group name="arm">
    <chain base_link="base_link" tip_link="cad_tip_reference" />
  </group>
  <group_state name="cad_zero" group="arm">
    <joint name="base_joint" value="0" />
    <joint name="shoulder_joint" value="0" />
    <joint name="elbow_joint" value="0" />
    <joint name="wrist_pitch_joint" value="0" />
    <joint name="wrist_rotation_joint" value="0" />
  </group_state>
  <group_state name="review_pose" group="arm">
    <joint name="base_joint" value="0.2" />
    <joint name="shoulder_joint" value="0.15" />
    <joint name="elbow_joint" value="-0.3" />
    <joint name="wrist_pitch_joint" value="0.15" />
    <joint name="wrist_rotation_joint" value="0" />
  </group_state>
  <disable_collisions link1="base_link" link2="shoulder_mount" reason="Adjacent" />
  <disable_collisions link1="shoulder_mount" link2="upper_arm_link" reason="Adjacent" />
  <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent" />
  <disable_collisions link1="forearm_link" link2="wrist_pitch_link" reason="Adjacent" />
  <disable_collisions link1="wrist_pitch_link" link2="wrist_rotation_link" reason="Adjacent" />
  <disable_collisions link1="wrist_rotation_link" link2="tool0" reason="Adjacent" />
  <disable_collisions link1="wrist_rotation_link" link2="cad_tip_reference" reason="Adjacent" />
  <group name="gripper">
    <joint name="gripper_drive_joint" />
    <joint name="left_rocker_joint" />
    <joint name="left_finger_joint" />
    <joint name="right_drive_joint" />
    <joint name="right_rocker_joint" />
    <joint name="right_finger_joint" />
  </group>
  <group_state name="open" group="gripper">
    <joint name="gripper_drive_joint" value="-.14844025287" />
  </group_state>
  <group_state name="close" group="gripper">
    <joint name="gripper_drive_joint" value=".58" />
  </group_state>
  <end_effector name="cad_gripper" parent_link="wrist_rotation_link" group="gripper" parent_group="arm" />
  <disable_collisions link1="wrist_rotation_link" link2="left_drive_link" reason="Adjacent" />
  <disable_collisions link1="wrist_rotation_link" link2="left_rocker_link" reason="Adjacent" />
  <disable_collisions link1="left_drive_link" link2="left_finger_link" reason="Adjacent" />
  <disable_collisions link1="wrist_rotation_link" link2="right_drive_link" reason="Adjacent" />
  <disable_collisions link1="wrist_rotation_link" link2="right_rocker_link" reason="Adjacent" />
  <disable_collisions link1="right_drive_link" link2="right_finger_link" reason="Adjacent" />
  <disable_collisions link1="left_rocker_link" link2="left_finger_link" reason="Mechanical coupling" />
  <disable_collisions link1="right_rocker_link" link2="right_finger_link" reason="Mechanical coupling" />
  <disable_collisions link1="left_drive_link" link2="right_drive_link" reason="Mechanical coupling" />
</robot>